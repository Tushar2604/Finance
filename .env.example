# ==========================================
# MongoDB Configuration
# ==========================================
# Local: mongodb://localhost:27017/bim-finance
# Vercel Production MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/bim-finance?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/bim-finance

# ==========================================
# Application URL
# ==========================================
# Local: http://localhost:3000
# Production: https://your-vercel-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# Authentication Secrets
# ==========================================
# Generate secure keys via: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars

# ==========================================
# External Services
# ==========================================
OPENAI_API_KEY=sk-...

NODE_ENV=development
